{
  "name": "smartstock-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "BDD (Gherkin) E2E tests for the live SmartStock app using playwright-bdd + Allure.",
  "type": "module",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "report": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "allure-playwright": "3.0.7",
    "playwright-bdd": "7.5.0"
  }
}
