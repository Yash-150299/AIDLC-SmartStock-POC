{
  "name": "smartstock",
  "version": "0.1.0",
  "private": true,
  "description": "SmartStock inventory management monorepo (shared + backend).",
  "workspaces": [
    "shared",
    "backend",
    "web"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace @smartstock/shared",
    "build:backend": "npm run build --workspace @smartstock/backend",
    "build": "npm run build:shared && npm run build:backend",
    "build:web": "npm run build:shared && npm run build --workspace @smartstock/web",
    "render:build": "npm ci && npm run build:shared && npm run prisma:generate && npm run build:backend",
    "render:start": "npm run start:prod --workspace @smartstock/backend",
    "dev": "npm run dev --workspace @smartstock/backend",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "npm run typecheck --workspace @smartstock/shared && npm run typecheck --workspace @smartstock/backend",
    "prisma:generate": "npm run prisma:generate --workspace @smartstock/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace @smartstock/backend",
    "seed": "npm run seed --workspace @smartstock/backend"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "supertest": "6.3.4",
    "ts-jest": "29.1.5"
  }
}
