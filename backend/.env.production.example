# SmartStock backend — PRODUCTION environment variables (set these in the Render dashboard).
# Do NOT commit a real .env.production. These are placeholders.

# Neon Postgres connection string (copy from the Neon dashboard → Connection Details).
# Use the pooled connection string and keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Long random secret for signing JWTs (Render can auto-generate via generateValue).
JWT_SECRET="replace-with-a-long-random-string"

# Access-token lifetime.
JWT_EXPIRES_IN="8h"

# Allowed browser origin(s) for CORS — your deployed Vercel frontend URL.
# Comma-separate multiple, or "*" to allow any (not recommended for real deployments).
CORS_ORIGIN="https://your-frontend.vercel.app"

# Render sets PORT automatically; no need to set it here.
