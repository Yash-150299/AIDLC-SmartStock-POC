# SmartStock backend — environment variable template
# Copy to `.env` and fill in real values for local development.
# NEVER commit a real .env file. These are placeholders only (no real secrets).

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartstock?schema=public"

# Secret used to sign JWT access tokens. Use a long, random value in real environments.
JWT_SECRET="change-me-to-a-long-random-string"

# Access-token lifetime (default 8h = one shift). Accepts any value supported by jsonwebtoken (e.g. 8h, 1h, 3600).
JWT_EXPIRES_IN="8h"

# HTTP port the backend listens on.
PORT="4000"
